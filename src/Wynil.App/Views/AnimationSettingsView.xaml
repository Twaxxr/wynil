<UserControl x:Class="Wynil.App.Views.AnimationSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Wynil.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,22,8,16">
        <TextBlock Text="Motion &amp; Timing" Style="{StaticResource SectionHeading}" />
        <Border Style="{StaticResource SettingRow}" Padding="12" Margin="0,0,0,7"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions><TextBlock Text="Animation quality" VerticalAlignment="Center"/><ComboBox Grid.Column="1" Style="{StaticResource DarkComboBox}" SelectedValuePath="Content" SelectedValue="{Binding Options.Animation.Quality}"><ComboBoxItem Content="Low"/><ComboBoxItem Content="Balanced"/><ComboBoxItem Content="High"/></ComboBox></Grid></Border>
        <Border Style="{StaticResource SettingRow}" Padding="12" Margin="0,0,0,7"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions><TextBlock Text="Target FPS" VerticalAlignment="Center"/><ComboBox Grid.Column="1" Style="{StaticResource DarkComboBox}" SelectedValuePath="Content" SelectedValue="{Binding Options.Scene.TargetFps}"><ComboBoxItem Content="30"/><ComboBoxItem Content="60"/></ComboBox></Grid></Border>
        <Border Style="{StaticResource SettingRow}" Padding="14" Margin="0,0,0,7"><StackPanel><Grid><TextBlock Text="Vinyl rotation speed"/><TextBlock Text="{Binding Options.Scene.VinylSpeed, StringFormat={}{0:F1}×}" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}"/></Grid><Slider Minimum="0.5" Maximum="1.5" Value="{Binding Options.Scene.VinylSpeed}" TickFrequency="0.1" Margin="0,8,0,0"/></StackPanel></Border>
        <Border Style="{StaticResource SettingRow}" Padding="14" Margin="0,0,0,7"><StackPanel><Grid><TextBlock Text="Transition duration"/><TextBlock Text="{Binding Options.Scene.TransitionSeconds, StringFormat={}{0:F1}s}" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}"/></Grid><Slider Minimum="0.2" Maximum="2.5" Value="{Binding Options.Scene.TransitionSeconds}" Margin="0,8,0,0"/></StackPanel></Border>
        <Border Style="{StaticResource SettingRow}" Padding="14" Margin="0,0,0,7"><StackPanel><Grid><TextBlock Text="Mouse parallax strength"/><TextBlock Text="{Binding Options.Scene.ParallaxStrength, StringFormat={}{0:F1}×}" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}"/></Grid><Slider Minimum="0" Maximum="2" Value="{Binding Options.Scene.ParallaxStrength}" Margin="0,8,0,0"/></StackPanel></Border>
        <controls:SettingToggle Title="Tonearm animation" IconData="M2,1 L8,7 M7,7 L9,9 M1,9 L4,9" IsChecked="{Binding Options.Scene.TonearmAnimation}" />
        <controls:SettingToggle Title="Audio-reactive visuals" Description="React to Windows output audio in the vinyl, lighting, dust, and tonearm." IconData="M1,6 L3,6 4,3 6,9 7,6 10,6" IsChecked="{Binding Options.Scene.AudioReactiveEnabled}" />
        <controls:SettingToggle Title="Reduce motion" Description="Minimizes transitions and decorative movement." IconData="M1,5 L9,5 M3,2 L1,5 3,8 M7,2 L9,5 7,8" IsChecked="{Binding Options.Scene.ReduceMotion}" />
    </StackPanel></ScrollViewer>
</UserControl>
