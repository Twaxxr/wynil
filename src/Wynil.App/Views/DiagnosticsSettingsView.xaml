<UserControl x:Class="Wynil.App.Views.DiagnosticsSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,22,8,16">
        <TextBlock Text="Runtime diagnostics" Style="{StaticResource SectionHeading}"/>
        <Border Style="{StaticResource SettingRow}" Padding="14"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Application" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding ApplicationVersion}" Margin="0,3,0,0"/><TextBlock Text="Windows" Style="{StaticResource MutedText}" Margin="0,12,0,0"/><TextBlock Text="{Binding WindowsVersion}" TextWrapping="Wrap" Margin="0,3,10,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Wallpaper engine" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding WallpaperProcessStatus}" Margin="0,3,0,0"/><TextBlock Text="Memory" Style="{StaticResource MutedText}" Margin="0,12,0,0"/><TextBlock Text="{Binding MemoryUsage}" Margin="0,3,0,0"/></StackPanel></Grid></Border>
        <TextBlock Text="Media &amp; configuration" Style="{StaticResource SectionHeading}" Margin="0,18,0,12"/>
        <Border Style="{StaticResource SettingRow}" Padding="14"><StackPanel><TextBlock Text="Current track identity" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding CurrentTrackIdentity}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" Margin="0,3,0,0"/><TextBlock Text="Last media change" Style="{StaticResource MutedText}" Margin="0,11,0,0"/><TextBlock Text="{Binding LastMediaChangeText}"/><TextBlock Text="Settings file" Style="{StaticResource MutedText}" Margin="0,11,0,0"/><TextBlock Text="{Binding SettingsFilePath}" TextWrapping="Wrap"/><TextBlock Text="Last error" Style="{StaticResource MutedText}" Margin="0,11,0,0"/><TextBlock Text="{Binding LastError}" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap"/></StackPanel></Border>
        <WrapPanel Margin="0,16,0,0"><Button Content="Restart wallpaper engine" Command="{Binding RestartWallpaperCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8"/><Button Content="Test sample song" Command="{Binding TestSampleSongCommand}" Style="{StaticResource BaseButton}" Margin="0,0,8,8"/><Button Content="Open logs" Command="{Binding OpenLogsCommand}" Style="{StaticResource BaseButton}" Margin="0,0,8,8"/></WrapPanel>
        <WrapPanel><Button Content="Export settings" Command="{Binding ExportSettingsCommand}" Style="{StaticResource BaseButton}" Margin="0,0,8,8"/><Button Content="Import settings" Command="{Binding ImportSettingsCommand}" Style="{StaticResource BaseButton}" Margin="0,0,8,8"/><Button Content="Reset settings" Command="{Binding ResetSettingsCommand}" Style="{StaticResource BaseButton}" Margin="0,0,8,8"/></WrapPanel>
    </StackPanel></ScrollViewer>
</UserControl>
