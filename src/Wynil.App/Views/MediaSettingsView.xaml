<UserControl x:Class="Wynil.App.Views.MediaSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Wynil.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,22,8,16">
        <TextBlock Text="Media Sources" Style="{StaticResource SectionHeading}" />
        <Border Style="{StaticResource SettingRow}" Padding="12" Margin="0,0,0,7"><StackPanel><TextBlock Text="Preferred media source" Style="{StaticResource MutedText}" Margin="0,0,0,7"/><TextBox Text="{Binding Options.Media.PreferredSource, UpdateSourceTrigger=PropertyChanged}" ToolTip="Windows application ID, or leave empty for automatic selection"/></StackPanel></Border>
        <Border Style="{StaticResource SettingRow}" Padding="14" Margin="0,0,0,7"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Active media session"/><TextBlock Text="{Binding ActiveSessionDescription}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/></StackPanel><Ellipse Grid.Column="1" Width="8" Height="8" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/></Grid></Border>
        <Border Style="{StaticResource SettingRow}" Padding="12" Margin="0,0,0,7"><StackPanel><TextBlock Text="Ignored applications" Style="{StaticResource MutedText}" Margin="0,0,0,7"/><TextBox Text="{Binding IgnoredApplicationsText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Comma-separated application IDs"/></StackPanel></Border>
        <controls:SettingToggle Title="Browser extension fallback" Description="Accept metadata only through the authenticated loopback bridge." IconData="M1,2 L9,2 9,9 1,9Z M1,4 L9,4 M3,3 L3,3 M5,3 L5,3" IsChecked="{Binding Options.Media.BrowserFallbackEnabled}" />
        <Border Style="{StaticResource SettingRow}" Padding="14" Margin="0,0,0,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Browser extension status"/><TextBlock Text="{Binding BrowserExtensionStatus}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,3,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" FontSize="18"/></Grid></Border>
        <TextBlock Text="Artwork &amp; Diagnostics" Style="{StaticResource SectionHeading}" />
        <Border Style="{StaticResource SettingRow}" Padding="12" Margin="0,0,0,7"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><TextBlock Text="Artwork cache size (MB)" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding Options.Media.ArtworkCacheMegabytes}" HorizontalContentAlignment="Right"/></Grid></Border>
        <Button Content="Clear artwork cache" Command="{Binding ClearArtworkCacheCommand}" Style="{StaticResource BaseButton}" HorizontalAlignment="Left" Margin="0,4,0,10"/>
        <Expander Header="Media debugging panel" Foreground="{DynamicResource PrimaryTextBrush}" Background="{DynamicResource ElevatedBrush}" Padding="12">
            <StackPanel Margin="0,10,0,0"><TextBlock Text="{Binding CurrentTrack.SourceId, StringFormat=Source ID: {0}}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding CurrentTrack.Position, StringFormat=Position: {0}}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding CurrentTrack.Duration, StringFormat=Duration: {0}}" Style="{StaticResource MutedText}"/></StackPanel>
        </Expander>
    </StackPanel></ScrollViewer>
</UserControl>
