<UserControl x:Class="Wynil.App.Views.AppearanceSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Wynil.App.Controls"
             xmlns:config="clr-namespace:Wynil.Core.Configuration;assembly=Wynil.Core">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,22,8,16">
            <TextBlock Text="Theme preset" Style="{StaticResource SectionHeading}" />
            <Border Style="{StaticResource SettingRow}" Padding="12" Margin="0,0,0,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox Style="{StaticResource DarkComboBox}" SelectedValuePath="Content" SelectedValue="{Binding SelectedThemePreset}"><ComboBoxItem Content="Warm Walnut"/><ComboBoxItem Content="Midnight Black"/><ComboBoxItem Content="White Studio"/><ComboBoxItem Content="Vintage Vinyl"/><ComboBoxItem Content="Luxury Marble"/><ComboBoxItem Content="Cozy Desk"/><ComboBoxItem Content="Minimal"/><ComboBoxItem Content="Artwork Adaptive"/></ComboBox><Button Grid.Column="1" Content="Apply" Command="{Binding ApplyThemePresetCommand}" Style="{StaticResource BaseButton}" Margin="10,0,0,0"/></Grid></Border>
            <TextBlock Text="Surface &amp; Style" Style="{StaticResource SectionHeading}" />
            <Border Style="{StaticResource SettingRow}" Padding="12" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Desk material" Style="{StaticResource MutedText}" Margin="0,0,0,7" />
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="26" Height="26" CornerRadius="4" Background="#704326" BorderBrush="#35FFFFFF" BorderThickness="1"/><ComboBox Grid.Column="1" Style="{StaticResource DarkComboBox}" SelectedValuePath="Tag" SelectedValue="{Binding Options.Scene.DeskMaterial}"><ComboBoxItem Content="Warm Walnut" Tag="{x:Static config:DeskMaterial.WarmWalnut}"/><ComboBoxItem Content="Dark Walnut" Tag="{x:Static config:DeskMaterial.DarkWalnut}"/><ComboBoxItem Content="Natural Oak" Tag="{x:Static config:DeskMaterial.NaturalOak}"/><ComboBoxItem Content="Black Wood" Tag="{x:Static config:DeskMaterial.BlackWood}"/><ComboBoxItem Content="White Studio" Tag="{x:Static config:DeskMaterial.WhiteStudio}"/><ComboBoxItem Content="Dark Marble" Tag="{x:Static config:DeskMaterial.DarkMarble}"/><ComboBoxItem Content="Light Marble" Tag="{x:Static config:DeskMaterial.LightMarble}"/></ComboBox></Grid>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SettingRow}" Padding="12" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Album sleeve style" Style="{StaticResource MutedText}" Margin="0,0,0,7" />
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="26" Height="26" CornerRadius="4" Background="{DynamicResource AccentBrush}"><Viewbox Margin="6"><Path Data="M1,1 L9,1 9,9 1,9Z M3,3 L7,3 7,7 3,7Z" Stroke="#17120C" StrokeThickness="1"/></Viewbox></Border><ComboBox Grid.Column="1" Style="{StaticResource DarkComboBox}" SelectedValuePath="Tag" SelectedValue="{Binding Options.Scene.AlbumSleeveStyle}"><ComboBoxItem Content="Automatic" Tag="{x:Static config:AlbumSleeveStyle.Automatic}"/><ComboBoxItem Content="Original Artwork" Tag="{x:Static config:AlbumSleeveStyle.OriginalArtwork}"/><ComboBoxItem Content="Minimal Modern" Tag="{x:Static config:AlbumSleeveStyle.MinimalModern}"/><ComboBoxItem Content="Black Luxury" Tag="{x:Static config:AlbumSleeveStyle.BlackLuxury}"/><ComboBoxItem Content="White Minimal" Tag="{x:Static config:AlbumSleeveStyle.WhiteMinimal}"/><ComboBoxItem Content="Vintage Vinyl" Tag="{x:Static config:AlbumSleeveStyle.VintageVinyl}"/><ComboBoxItem Content="Artwork Adaptive" Tag="{x:Static config:AlbumSleeveStyle.ArtworkAdaptive}"/><ComboBoxItem Content="Spotify-inspired" Tag="{x:Static config:AlbumSleeveStyle.SpotifyInspired}"/><ComboBoxItem Content="No Sleeve" Tag="{x:Static config:AlbumSleeveStyle.NoSleeve}"/></ComboBox></Grid>
                </StackPanel>
            </Border>

            <TextBlock Text="Visual Enhancements" Style="{StaticResource SectionHeading}" />
            <controls:SettingToggle Title="Film grain" IconData="M2,2 L3,2 M7,2 L8,2 M5,5 L6,5 M2,8 L3,8 M8,8 L9,8" IsChecked="{Binding Options.Scene.FilmGrainEnabled}" />
            <controls:SettingToggle Title="Dust particles" IconData="M2,3 A1,1 0 1 1 4,3 A1,1 0 1 1 2,3 M7,2 A1,1 0 1 1 9,2 M5,7 A1,1 0 1 1 7,7 M1,9 L2,9 M9,8 L10,8" IsChecked="{Binding Options.Scene.DustParticlesEnabled}" />
            <controls:SettingToggle Title="Mouse parallax" IconData="M2,1 L9,6 6,7 5,10Z" IsChecked="{Binding Options.Scene.MouseParallaxEnabled}" />
            <controls:SettingToggle Title="Artwork-based ambient lighting" IconData="M5,1 A4,4 0 1 1 4.9,1 M5,0 L5,2 M5,8 L5,10 M0,5 L2,5 M8,5 L10,5" IsChecked="{Binding Options.Scene.ArtworkAmbientLightingEnabled}" />
            <controls:SettingToggle Title="Show song information" IconData="M5,1 A4,4 0 1 1 4.9,1 M5,4 L5,8 M5,2 L5,2.2" IsChecked="{Binding Options.Scene.ShowSongInformation}" />
            <Border Style="{StaticResource SettingRow}" Padding="13" Margin="0,10,0,7"><StackPanel><Grid><TextBlock Text="Film grain intensity"/><TextBlock Text="{Binding Options.Scene.FilmGrainIntensity, StringFormat={}{0:P0}}" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}"/></Grid><Slider Minimum="0" Maximum="1" Value="{Binding Options.Scene.FilmGrainIntensity}" Margin="0,7,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource SettingRow}" Padding="13" Margin="0,0,0,7"><StackPanel><Grid><TextBlock Text="Dust intensity"/><TextBlock Text="{Binding Options.Scene.DustIntensity, StringFormat={}{0:P0}}" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}"/></Grid><Slider Minimum="0" Maximum="1" Value="{Binding Options.Scene.DustIntensity}" Margin="0,7,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource SettingRow}" Padding="13" Margin="0,0,0,7"><StackPanel><Grid><TextBlock Text="Ambient lighting"/><TextBlock Text="{Binding Options.Scene.AmbientLightingIntensity, StringFormat={}{0:P0}}" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}"/></Grid><Slider Minimum="0" Maximum="1" Value="{Binding Options.Scene.AmbientLightingIntensity}" Margin="0,7,0,0"/></StackPanel></Border>

            <Border Style="{StaticResource SettingRow}" Background="#0EFFFFFF" Margin="0,12,0,0" Padding="14">
                <StackPanel Orientation="Horizontal"><TextBlock Text="" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource AccentBrush}" FontSize="22" Margin="0,0,12,0"/><StackPanel><TextBlock Text="Changes are kept while you browse settings." FontSize="13"/><TextBlock Text="Choose Save settings to write them to your profile." Style="{StaticResource MutedText}" FontSize="12" Margin="0,3,0,0"/></StackPanel></StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
