<UserControl x:Class="NowSpinning.App.Controls.SettingToggle"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" Focusable="False">
    <Border Style="{StaticResource SettingRow}" Margin="0,0,0,5">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Viewbox Width="17" Height="17" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Path Data="{Binding IconData, ElementName=Root}" Stroke="{DynamicResource SecondaryTextBrush}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Viewbox>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title, ElementName=Root}" FontSize="14" />
                <TextBlock Text="{Binding Description, ElementName=Root}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,2,10,0"
                           Visibility="{Binding HasDescription, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
            <ToggleButton Grid.Column="2" IsChecked="{Binding IsChecked, ElementName=Root, Mode=TwoWay}" Style="{StaticResource ToggleSwitch}"
                          VerticalAlignment="Center" AutomationProperties.Name="{Binding Title, ElementName=Root}" />
        </Grid>
    </Border>
</UserControl>
