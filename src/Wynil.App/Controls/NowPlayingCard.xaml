<UserControl x:Class="Wynil.App.Controls.NowPlayingCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wallpaper="clr-namespace:Wynil.Wallpaper;assembly=Wynil.Wallpaper">
    <UserControl.Resources>
        <Style x:Key="TransportButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Width" Value="44"/><Setter Property="Height" Value="44"/><Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/><Setter Property="Background" Value="{DynamicResource ElevatedBrush}"/><Setter Property="FontFamily" Value="Segoe Fluent Icons"/><Setter Property="FontSize" Value="18"/>
        </Style>
        <Style x:Key="PrimaryTransportButton" TargetType="Button" BasedOn="{StaticResource TransportButton}">
            <Setter Property="Width" Value="54"/><Setter Property="Height" Value="54"/><Setter Property="Background" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="#17120C"/><Setter Property="FontSize" Value="22"/>
        </Style>
        <Style x:Key="ProgressSlider" TargetType="Slider">
            <Setter Property="Height" Value="18" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="3" Background="{DynamicResource AccentBrush}" CornerRadius="2" /></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
                                <Track.Thumb><Thumb Width="11" Height="11"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="#DDE4ED" /></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                                <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="3" Background="#405065" CornerRadius="2" /></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Border Style="{StaticResource Card}" Padding="20">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="NOW PLAYING" Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="SemiBold" />
            <Border Grid.Row="1" CornerRadius="7" ClipToBounds="True" Margin="0,14,0,14" Background="#050A10" MinHeight="250">
                <wallpaper:WallpaperPreviewControl x:Name="Preview" Track="{Binding CurrentTrack}" Settings="{Binding PreviewSettings}" />
            </Border>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding DisplayTitle}" FontSize="26" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                        <TextBlock Text="" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource AccentBrush}" FontSize="13" Width="24" />
                        <TextBlock Text="{Binding DisplayArtist}" Style="{StaticResource MutedText}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0" Visibility="{Binding HasAlbum, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource AccentBrush}" FontSize="13" Width="24" />
                        <TextBlock Text="{Binding CurrentTrack.Album}" Style="{StaticResource MutedText}" />
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" Background="#142335" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="11,5" VerticalAlignment="Bottom" Margin="12,0,0,4">
                    <TextBlock Text="{Binding DisplaySource}" Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="SemiBold" />
                </Border>
            </Grid>
            <Grid Grid.Row="3" Margin="0,14,0,0">
                <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Slider Minimum="0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}" IsHitTestVisible="False" Focusable="False" Style="{StaticResource ProgressSlider}" />
                <Grid Grid.Row="1" Margin="0,2,0,0"><TextBlock Text="{Binding PositionText}" Style="{StaticResource MutedText}" FontSize="11"/><TextBlock Text="{Binding DurationText}" Style="{StaticResource MutedText}" FontSize="11" HorizontalAlignment="Right"/></Grid>
            </Grid>
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                <Button Command="{Binding PreviousCommand}" IsEnabled="{Binding CurrentTrack.CanSkipPrevious}" Style="{StaticResource TransportButton}" ToolTip="Previous track" AutomationProperties.Name="Previous track"><Path Data="M8,2 L8,8 3,5Z M2,2 L2,8" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Width="15" Height="15" Stretch="Fill"/></Button>
                <Button Command="{Binding TogglePlaybackCommand}" IsEnabled="{Binding CurrentTrack.CanPlayPause}" Style="{StaticResource PrimaryTransportButton}" Margin="12,0" ToolTip="Play or pause" AutomationProperties.Name="Play or pause"><Path Data="{Binding PlaybackIconGeometry}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="17" Height="17" Stretch="Uniform"/></Button>
                <Button Command="{Binding NextCommand}" IsEnabled="{Binding CurrentTrack.CanSkipNext}" Style="{StaticResource TransportButton}" ToolTip="Next track" AutomationProperties.Name="Next track"><Path Data="M2,2 L2,8 7,5Z M8,2 L8,8" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Width="15" Height="15" Stretch="Fill"/></Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
