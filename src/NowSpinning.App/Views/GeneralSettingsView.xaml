<UserControl x:Class="NowSpinning.App.Views.GeneralSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:NowSpinning.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,22,8,16">
        <TextBlock Text="Startup &amp; Window" Style="{StaticResource SectionHeading}" />
        <controls:SettingToggle Title="Start with Windows" Description="Launch the companion when you sign in." IconData="M1,1 L5,1 5,5 1,5Z M6,1 L10,1 10,5 6,5Z M1,6 L5,6 5,10 1,10Z M6,6 L10,6 10,10 6,10Z" IsChecked="{Binding Options.General.StartWithWindows}" />
        <controls:SettingToggle Title="Minimize to system tray" IconData="M1,2 L9,2 9,8 1,8Z M3,10 L7,10" IsChecked="{Binding Options.General.MinimizeToTray}" />
        <controls:SettingToggle Title="Start wallpaper automatically" IconData="M1,2 L9,2 9,8 1,8Z M4,4 L7,5 4,6Z" IsChecked="{Binding Options.General.StartWallpaperAutomatically}" />
        <TextBlock Text="Displays" Style="{StaticResource SectionHeading}" Margin="0,18,0,12" />
        <Border Style="{StaticResource SettingRow}" Padding="12" Margin="0,0,0,7"><StackPanel><TextBlock Text="Selected monitor" Style="{StaticResource MutedText}" Margin="0,0,0,7"/><ComboBox Style="{StaticResource DarkComboBox}" SelectedValuePath="Content" SelectedValue="{Binding Options.Scene.SelectedMonitor}"><ComboBoxItem Content="All monitors"/><ComboBoxItem Content="Primary monitor"/></ComboBox></StackPanel></Border>
        <controls:SettingToggle Title="Span across monitors" IconData="M1,2 L5,2 5,8 1,8Z M6,2 L10,2 10,8 6,8Z" IsChecked="{Binding Options.Scene.SpanAcrossMonitors}" />
        <controls:SettingToggle Title="Pause on lock screen" IconData="M3,5 L3,3 A2,2 0 0 1 7,3 L7,5 M2,5 L8,5 8,10 2,10Z" IsChecked="{Binding Options.General.PauseWhenLocked}" />
        <controls:SettingToggle Title="Resume automatically" IconData="M8,3 A4,4 0 1 0 9,6 M8,1 L8,4 5,4" IsChecked="{Binding Options.General.ResumeAutomatically}" />
    </StackPanel></ScrollViewer>
</UserControl>
