<UserControl x:Class="NowSpinning.App.Views.PerformanceSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:NowSpinning.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,22,8,16">
        <TextBlock Text="Power &amp; Rendering" Style="{StaticResource SectionHeading}" />
        <controls:SettingToggle Title="Low-power mode" Description="Limits effects and uses the lower frame-rate target." IconData="M6,1 L2,6 5,6 4,10 9,4 6,4Z" IsChecked="{Binding Options.Scene.LowPowerMode}" />
        <controls:SettingToggle Title="Pause during fullscreen apps" Description="Keeps the wallpaper visible but freezes animation and effects until fullscreen closes." IconData="M1,4 L1,1 4,1 M7,1 L10,1 10,4 M10,7 L10,10 7,10 M4,10 L1,10 1,7" IsChecked="{Binding Options.Scene.PauseDuringFullscreenApps}" />
        <controls:SettingToggle Title="Pause on battery" IconData="M2,2 L8,2 8,9 2,9Z M8,4 L10,4 10,7 8,7 M4,4 L6,4 6,7 4,7Z" IsChecked="{Binding Options.General.PauseOnBattery}" />
        <controls:SettingToggle Title="Hardware acceleration" Description="Use GPU-accelerated WebView2 composition." IconData="M2,2 L8,2 8,8 2,8Z M0,4 L2,4 M8,4 L10,4 M4,0 L4,2 M6,8 L6,10" IsChecked="{Binding Options.Performance.HardwareAcceleration}" />
        <TextBlock Text="Limits" Style="{StaticResource SectionHeading}" Margin="0,18,0,12" />
        <Border Style="{StaticResource SettingRow}" Padding="12" Margin="0,0,0,7"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions><TextBlock Text="Maximum FPS" VerticalAlignment="Center"/><ComboBox Grid.Column="1" Style="{StaticResource DarkComboBox}" SelectedValuePath="Content" SelectedValue="{Binding Options.Wallpaper.TargetFramesPerSecond}"><ComboBoxItem Content="30"/><ComboBoxItem Content="60"/></ComboBox></Grid></Border>
        <Border Style="{StaticResource SettingRow}" Padding="12" Margin="0,0,0,7"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions><TextBlock Text="GPU usage mode" VerticalAlignment="Center"/><ComboBox Grid.Column="1" Style="{StaticResource DarkComboBox}" SelectedValuePath="Content" SelectedValue="{Binding Options.Performance.GpuUsageMode}"><ComboBoxItem Content="Efficiency"/><ComboBoxItem Content="Balanced"/><ComboBoxItem Content="Quality"/></ComboBox></Grid></Border>
        <Border Style="{StaticResource SettingRow}" Padding="14"><StackPanel><Grid><TextBlock Text="Maximum GPU budget"/><TextBlock Text="{Binding Options.Performance.MaximumGpuPercent, StringFormat={}{0}%}" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}"/></Grid><Slider Minimum="10" Maximum="100" Value="{Binding Options.Performance.MaximumGpuPercent}" Margin="0,8,0,0"/></StackPanel></Border>
    </StackPanel></ScrollViewer>
</UserControl>
